{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triage-harness/schemas/verdict.json",
  "title": "Triage verdict",
  "description": "Field order is load-bearing: threat_model is required before verdict, which forces the reasoning to precede the conclusion.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "alert_key",
    "threat_model",
    "verdict",
    "vex_status",
    "reachability_confirmed",
    "confidence",
    "production_reachable",
    "evidence_cited",
    "recommended_action",
    "unknowns",
    "needs_human"
  ],
  "properties": {
    "alert_key": { "type": "string" },
    "threat_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attacker", "boundary_crossed", "assumption_broken", "preconditions"],
      "properties": {
        "attacker": { "type": "string", "minLength": 1 },
        "boundary_crossed": { "type": "string", "minLength": 1 },
        "assumption_broken": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["affected", "not_affected", "fixed", "could_not_determine"]
    },
    "vex_status": {
      "type": "string",
      "enum": ["affected", "not_affected", "fixed", "under_investigation"]
    },
    "vex_justification": {
      "type": ["string", "null"],
      "enum": [
        "component_not_present",
        "vulnerable_code_not_present",
        "vulnerable_code_not_in_execute_path",
        "vulnerable_code_cannot_be_controlled_by_adversary",
        "inline_mitigations_already_exist",
        null
      ]
    },
    "reachability_confirmed": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "production_reachable": { "type": ["boolean", "null"] },
    "severity_adjusted": { "type": ["string", "null"] },
    "severity_rationale": { "type": ["string", "null"] },
    "evidence_cited": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "why"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommended_action": { "type": "string" },
    "owner_hint": { "type": ["string", "null"] },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "needs_human": { "type": "boolean" },
    "decided_by": { "type": "string" },
    "rule_id": { "type": ["string", "null"] },
    "rule_detail": { "type": "object" },
    "tool_calls_used": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "vex_status": { "const": "not_affected" } }, "required": ["vex_status"] },
      "then": {
        "properties": {
          "vex_justification": {
            "type": "string",
            "enum": [
              "component_not_present",
              "vulnerable_code_not_present",
              "vulnerable_code_not_in_execute_path",
              "vulnerable_code_cannot_be_controlled_by_adversary",
              "inline_mitigations_already_exist"
            ]
          }
        },
        "required": ["vex_justification"]
      }
    }
  ]
}
